# ============================================================
# Akwasi Backend — Environment Variables
# Copy this file to .env and fill in your values
# This file is NEVER pushed to GitHub
# ============================================================

# Server
PORT=3001

# Supabase
SUPABASE_URL=https://lgcatiumbyswblbbjjrn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string_32chars_min

# Admin credentials (used during DB seed to create the admin user)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_secure_password

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Arkesel SMS API
ARKESEL_API_KEY=your_arkesel_api_key_here
ARKESEL_SENDER_ID=Akwasi
